# ─────────────────────────────────────────────────────────────────────────────
# ENVIRONMENT VARIABLES (EXAMPLE / TEMPLATE)
# Copy this file to .env and fill in values before starting the application.
# Never commit your real .env file or production credentials to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Auth (better-auth) ───────────────────────────────────────────────────────
BETTER_AUTH_SECRET=example_better_auth_secret_generate_with_openssl_rand_base64_32
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://user:password@localhost:5432/availability_tracker"
DIRECT_URL="postgresql://user:password@localhost:5432/availability_tracker"

# ─── Admin Access & Credentials ───────────────────────────────────────────────
admin_email=admin@email.com
ADMIN_EMAIL=admin@email.com
ADMIN_EMAILS=admin@email.com
password="example password"
ADMIN_PASSWORD="example password"
