# ─────────────────────────────────────────────────────────────────────────────
# ENVIRONMENT VARIABLES (EXAMPLE / TEMPLATE)
# Copy this file to .env and fill in values before starting the application.
# Never commit your real .env file or production credentials to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Auth (better-auth) ───────────────────────────────────────────────────────
BETTER_AUTH_SECRET=example_better_auth_secret_generate_with_openssl_rand_base64_32
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
# Optional: Set to false to disable rate limiting entirely during development or testing
RATE_LIMIT_ENABLED=true

# ─── Database ─────────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://user:password@localhost:5432/availability_tracker"
DIRECT_URL="postgresql://user:password@localhost:5432/availability_tracker"

# ─── Admin Access & Credentials ───────────────────────────────────────────────
admin_email=admin@email.com
ADMIN_EMAIL=admin@email.com
ADMIN_EMAILS=admin@email.com
password="example password"
ADMIN_PASSWORD="example password"
SUPER_ADMIN_EMAILS=a.wesam2300@nu.edu.eg,o.emad2302@nu.edu.eg,m.ashraf2372@nu.edu.eg
# Secret token required to access /api/setup-admin in production (e.g. /api/setup-admin?token=your_token_here)
SETUP_ADMIN_TOKEN="example_setup_admin_token"
MS_GRAPH_TENANT_ID=
# Mailbox a super admin connects under Admin > Requests. Delegated Mail.Send, offline_access, User.Read on the Entra app;
# register <origin>/api/admin/mailer/microsoft/callback as a Web redirect URI.
MAIL_SENDER=technicalsu@nu.edu.eg
# 32 random bytes as base64 (openssl rand -base64 32). Encrypts the stored refresh token; changing it means reconnecting.
MAILER_TOKEN_KEY=
